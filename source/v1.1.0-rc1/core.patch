+# Clutch delay controls the pause when changing forward/neutral/reverse. Stock tank value: ~0.4 sec.
+tracked_clutch_delay_seconds=0.0
+
+# 1.0 = vanilla drivetrain gearing/torque. 1.2 raises geared top speed by ~20% while also
+# raising max engine torque by the same factor to preserve approximately stock wheel torque.
+tracked_top_speed_scale=1.2
+
+# 1.0 = vanilla Havok steering envelope. This scales max steering angle and the speed at which
+# full steering angle is available. It does NOT directly change the neutral/pivot-turn cap.
+tracked_driving_turn_scale=1.2
